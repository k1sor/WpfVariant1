<Page x:Class="WpfVariant1.Pages.Task1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Задача 1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,20"
                   Text="Задача 1 (вариант 1). Число вводится своим двоичным представлением (длина числа не превышает 10000 двоичных разрядов). Необходимо определить, делится ли число на 15."/>

        <TextBlock Grid.Row="1" Text="Введите двоичное число (только символы 0 и 1):" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtInput"
                 Grid.Row="2"
                 Width="500"
                 HorizontalAlignment="Left"
                 HorizontalContentAlignment="Left"
                 TextWrapping="Wrap"
                 AcceptsReturn="False"
                 MaxLength="10000"
                 Margin="0,0,0,15"/>

        <Button x:Name="BtnCalculate"
                Grid.Row="3"
                Content="Выполнить"
                Width="140"
                Height="30"
                HorizontalAlignment="Left"
                Click="BtnCalculate_Click"
                Margin="0,0,0,15"/>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Результат:" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtResult"
                     Width="500"
                     Height="60"
                     HorizontalAlignment="Left"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Background="#F0F0F0"/>
        </StackPanel>
    </Grid>
</Page>
