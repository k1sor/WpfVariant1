<Page x:Class="WpfVariant1.Pages.Task4Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Задача 4">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,20"
                   Text="Задача 4 (вариант 1). Дан массив целых чисел x[1]..x[m+n], рассматриваемый как соединение двух отрезков: начала x[1]..x[m] длины m и конца x[m+1]..x[m+n] длины n. Не используя дополнительных массивов, переставить начало и конец местами (число действий порядка m+n)."/>

        <TextBlock Grid.Row="1" Text="Введите элементы массива через пробел (x[1] .. x[m+n]):" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtArray"
                 Grid.Row="2"
                 Width="500"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="Введите длину первого отрезка m:" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtM"
                 Grid.Row="4"
                 Width="100"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,15"/>

        <Button x:Name="BtnCalculate"
                Grid.Row="5"
                Content="Выполнить"
                Width="140"
                Height="30"
                HorizontalAlignment="Left"
                Click="BtnCalculate_Click"
                Margin="0,0,0,15"/>

        <StackPanel Grid.Row="6">
            <TextBlock Text="Результат:" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtResult"
                     Width="500"
                     Height="60"
                     HorizontalAlignment="Left"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Background="#F0F0F0"/>
        </StackPanel>
    </Grid>
</Page>
