<Window x:Class="WpfVariant1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическое занятие. Вариант 1 (Шереметов И.В., ПР-25.106)" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок главной формы: номер варианта -->
        <Border Grid.Row="0" Background="#2F4F6F">
            <TextBlock Text="Вариант № 1. Шереметов Иван, группа ПР-25.106"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Панель навигации: кнопки перехода к заданиям -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Button x:Name="BtnTask1" Content="Задача 1" Width="150" Height="35" Margin="5" Click="BtnTask1_Click"/>
            <Button x:Name="BtnTask2" Content="Задача 2" Width="150" Height="35" Margin="5" Click="BtnTask2_Click"/>
            <Button x:Name="BtnTask3" Content="Задача 3" Width="150" Height="35" Margin="5" Click="BtnTask3_Click"/>
            <Button x:Name="BtnTask4" Content="Задача 4" Width="150" Height="35" Margin="5" Click="BtnTask4_Click"/>
            <Button x:Name="BtnTask5" Content="Задача 5" Width="150" Height="35" Margin="5" Click="BtnTask5_Click"/>
        </StackPanel>

        <!-- Область отображения страниц с заданиями -->
        <Frame x:Name="MainFrame" Grid.Row="2" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
